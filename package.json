{
  "name": "scrap-and-steel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Physics-based robot building sandbox and 1v1 arena fighter. Browser-first.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test",
    "deploy:worker": "wrangler deploy",
    "tail:worker": "wrangler tail"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0",
    "wrangler": "^4.128.0",
    "ws": "^8.21.3"
  },
  "dependencies": {
    "planck-js": "^1.3.0"
  }
}
