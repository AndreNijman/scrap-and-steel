{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scrap-and-steel-relay",
  "main": "worker/relay.js",
  "compatibility_date": "2026-08-11",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "Room"
      },
      {
        "name": "REGISTRY",
        "class_name": "LobbyRegistry"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Room", "LobbyRegistry"]
    }
  ],
  "routes": [
    {
      "pattern": "relay.scrap.andrenijman.com",
      "custom_domain": true
    }
  ]
}
